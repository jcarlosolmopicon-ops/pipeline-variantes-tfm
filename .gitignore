# Nextflow runtime
.nextflow/
.nextflow.log*
work/
datos-intermedios/nextflow-work/

# Datos grandes (no versionar)
datos-raw/HCC1395/
datos-raw/TCGA-LUAD/
datos-raw/referencia/
datos-raw/clinvar/
datos-raw/**/*.fastq.gz
datos-raw/**/*.bam
datos-raw/**/*.fa
datos-raw/**/*.fa.gz
datos-raw/**/*.fasta
datos-raw/**/*.sra
datos-intermedios/*.bam
datos-intermedios/*.bai
datos-intermedios/*.vcf.gz
datos-intermedios/*.tbi

# Intermedios pesados del pipeline (regenerables de forma determinista)
resultados/*/bam/
resultados/*/bqsr/
resultados/*/trim/
resultados/*/markdup/*.bam
resultados/*/markdup/*.bai

# Corridas de prueba y desarrollo (no forman parte de los resultados de la memoria)
resultados/exp01/
resultados/exp02/
resultados/test/
resultados/test_all/

# Nota: los modelos serializados de exp04 (model_*.joblib, ~17 MB) y los informes de
# ejecucion de exp03 (pipeline_info/) SI se versionan: documentan los resultados del TFM.

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Conda
.conda/

# Instaladores y ficheros sueltos
Miniforge3-*.sh
*.config.save
version?current=*
FASTQC*

# OS y editores
.DS_Store
Thumbs.db
.~lock.*#
