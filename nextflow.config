/*
 * nextflow.config — Pipeline de variantes somáticas
 * TFM: Juan Carlos Olmo Picón — UAX Bioinformática 2025
 * Refs: NB-005, ADR-01, ADR-07, ADR-08
 */

params {
    input          = "datos-raw/HCC1395/*_{1,2}.fastq.gz"
    outdir         = "resultados/exp03_run_completa"

    genome         = "/home/olmop/pipeline-variantes/datos-raw/referencia/GRCh38.fa"
    genome_index   = "/home/olmop/pipeline-variantes/datos-raw/referencia/GRCh38.fa.fai"

    truth_vcf      = "/home/olmop/pipeline-variantes/datos-raw/HCC1395/truth_set/highconf_sSNV.vcf.gz"
    truth_bed      = "/home/olmop/pipeline-variantes/datos-raw/HCC1395/truth_set/highconf_regions.bed"

    maf_grch38     = "/home/olmop/pipeline-variantes/datos-raw/TCGA-LUAD/TCGA-LUAD.mutect2.GRCh38.maf.gz"

    dbsnp          = "/home/olmop/pipeline-variantes/datos-raw/referencia/dbsnp138.vcf.gz"
    dbsnp_index    = "/home/olmop/pipeline-variantes/datos-raw/referencia/dbsnp138.vcf.gz.tbi"

    max_cpus       = 12
    max_memory     = "28.GB"
    max_time       = "24.h"
    step = "all"
}

profiles {

    local {
        process.executor    = 'local'
        docker.enabled      = true
        docker.runOptions   = '--platform linux/amd64 -u $(id -u):$(id -g)'
        process.cpus        = 12
        process.memory      = '28 GB'
    }

    conda_local {
        process.executor    = 'local'
        conda.enabled       = true
        conda.cacheDir      = System.getenv("HOME") + "/.conda-nf-cache"
        process.cpus        = 12
        process.memory      = '28  GB'
	executor.queueSize  = 2
    }

    hpc {
        includeConfig 'config/hpc.config'
    }

    test {
        process.executor    = 'local'
        docker.enabled      = true
        docker.runOptions   = '--platform linux/amd64 -u $(id -u):$(id -g)'
        params.input        = "datos-raw/tests/*_R{1,2}.fastq.gz"
	params.step         = "all"
        params.outdir       = "resultados/test"
        process.cpus        = 4
        process.memory      = '8 GB'
    }
}

workDir        = 'datos-intermedios/nextflow-work'
conda.cacheDir = System.getenv("HOME") + "/.conda-nf-cache"

process {
    withLabel: 'low_cpu' {
        cpus   = 2
        memory = '4 GB'
        time   = '2 h'
    }
    withLabel: 'high_cpu' {
        cpus   = 12
        memory = '28 GB'
        time   = '24 h'
    }
    withLabel: 'gatk' {
        cpus   = 12
        memory = '28 GB'
        time   = '48 h'
    }
    withLabel: 'vep' {
        cpus   = 6
        memory = '16 GB'
        time   = '12 h'
        containerOptions = "-v /home/olmop/.vep:/home/olmop/.vep"
    }
}

process.conda = "$projectDir/entorno/environment.yml"

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

nextflowVersion = '>=24.0'

manifest {
    name            = 'pipeline-variantes'
    author          = 'Juan Carlos Olmo Picón'
    description     = 'Pipeline reproducible para análisis de variantes somáticas con clasificación ML'
    version         = '0.1.0'
    nextflowVersion = '>=24.0'
    mainScript      = 'main.nf'
}
