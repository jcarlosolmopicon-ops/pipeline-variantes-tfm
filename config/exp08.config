/*
 * config/exp08.config — Workaround para la recoleccion de metricas.
 *
 * El date de uutils-coreutils >= 0.8 (Ubuntu 25.10+ actualizado) no respeta
 * el formato %3N que emplea la funcion nxf_date del wrapper de Nextflow
 * 25.10.4: la recoleccion de metricas de trace/report/timeline aborta la
 * tarea despues de completarse el computo. Este fichero desactiva esos
 * informes; se carga con -c junto al nextflow.config del proyecto y no
 * afecta a los resultados de ningun proceso.
 *
 * Ver docs/instalacion.md, seccion de problemas conocidos.
 */

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
