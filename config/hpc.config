profiles {
    hpc {
        process.executor       = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            cpus   = 4
            memory = '16.GB'
            time   = '4.h'
            queue  = 'short'
        }
        process {
            withLabel: 'big_mem' {
                memory = '64.GB'
                cpus   = 16
                time   = '24.h'
                queue  = 'long'
            }
        }
    }
}
